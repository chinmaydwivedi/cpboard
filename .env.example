# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/cpboard"
# Recommended for Neon migrations: the same endpoint without `-pooler`.
# Prisma CLI falls back to DATABASE_URL when this is omitted.
DIRECT_URL=""

# Authentication and email
AUTH_SECRET="replace-with-a-random-secret"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CPBoard <no-reply@example.com>"

# Scheduled jobs
CRON_SECRET="replace-with-a-random-secret"

# Browser push (generate once with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"

# Optional
ADMIN_ALLOWLIST_EMAILS=""
POTD_ADMIN_ALLOWLIST_EMAILS=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""
# Optional override; by default the latest changelog entry controls the What's New prompt.
NEXT_PUBLIC_WHATS_NEW_RELEASE=""
