generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Platform {
  CODEFORCES
  LEETCODE
  ATCODER
  CODECHEF
}

enum SyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ProblemPlatform {
  LEETCODE
  CODEFORCES
  ATCODER
  CODECHEF
}

enum SolutionLanguage {
  JAVA
  CPP
  PYTHON
}

model University {
  id          String   @id @default(cuid())
  name        String
  shortName   String   @unique
  emailDomain String   @unique
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([emailDomain])
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String?
  username           String    @unique
  avatarUrl          String?
  role               Role      @default(STUDENT)
  profileViews       Int       @default(0)
  universityId       String
  emailVerified      DateTime?
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  university       University        @relation(fields: [universityId], references: [id])
  platformProfiles PlatformProfile[]
  dailyActivities  DailyActivity[]
  syncLogs         SyncLog[]
  accounts         Account[]
  sessions         Session[]
  pageVisits       PageVisit[]
  dailyPracticeProblemsCreated DailyPracticeProblem[]  @relation("DailyPracticeProblemsCreated")
  dailyPracticeSolutionsCreated DailyPracticeSolution[] @relation("DailyPracticeSolutionsCreated")
  dailyPracticeComments DailyPracticeComment[]
  potdSolves PotdSolve[]

  @@index([universityId])
  @@index([username])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PlatformProfile {
  id             String   @id @default(cuid())
  userId         String
  platform       Platform
  handle         String
  rating         Int      @default(0)
  maxRating      Int      @default(0)
  problemsSolved Int      @default(0)
  rank           String?
  contestsCount  Int      @default(0)
  lastSynced     DateTime?
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform])
  @@index([platform])
  @@index([rating])
  @@index([problemsSolved])
}

model DailyActivity {
  id              String   @id @default(cuid())
  userId          String
  platform        Platform
  date            DateTime @db.Date
  submissionCount Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, date])
  @@index([userId, date])
  @@index([date])
}

model SyncLog {
  id       String     @id @default(cuid())
  userId   String
  platform Platform
  status   SyncStatus
  error    String?
  syncedAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([syncedAt])
}

model PageVisit {
  id           String   @id @default(cuid())
  path         String
  visitorId    String
  viewerUserId String?
  createdAt    DateTime @default(now())

  viewerUser User? @relation(fields: [viewerUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([path, createdAt])
  @@index([viewerUserId, createdAt])
  @@index([visitorId, path, createdAt])
}

model DailyPracticeProblem {
  id          String          @id @default(cuid())
  date        DateTime        @unique @db.Date
  platform    ProblemPlatform
  title       String
  problemUrl  String
  difficulty  String?
  notes       String?
  isPublished Boolean         @default(false)
  createdById String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  createdBy User @relation("DailyPracticeProblemsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  solutions DailyPracticeSolution[]
  comments  DailyPracticeComment[]
  solves    PotdSolve[]

  @@index([date])
  @@index([isPublished, date])
  @@index([createdById])
}

model DailyPracticeSolution {
  id          String           @id @default(cuid())
  problemId   String
  language    SolutionLanguage
  code        String           @db.Text
  explanation String?          @db.Text
  createdById String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  problem   DailyPracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  createdBy User                @relation("DailyPracticeSolutionsCreated", fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([problemId, language])
  @@index([createdById])
}

model DailyPracticeComment {
  id        String   @id @default(cuid())
  problemId String
  userId    String
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  problem DailyPracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([problemId, createdAt])
  @@index([userId, createdAt])
}

model PotdSolve {
  id        String   @id @default(cuid())
  problemId String
  userId    String
  solvedAt  DateTime @default(now())
  solvedDate DateTime @db.Date

  problem DailyPracticeProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([problemId, userId])
  @@index([userId, solvedDate])
}
